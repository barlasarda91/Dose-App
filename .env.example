SQUARE_ACCESS_TOKEN=your_square_production_token_here
NODE_ENV=production
PORT=3001
# Optional: set a custom path for the SQLite database (Railway volume mounts at /app/data)
DB_PATH=/app/data/dose.db

# Strongly recommended: shared password protecting the app and API.
# Without it anyone with the URL can read sales data and place orders.
DOSE_PASSWORD=choose-a-strong-password

# Ordering (Place Order page): Resend API key for emailing orders to the roastery.
# Orders are saved to the log but not emailed if this is unset.
RESEND_API_KEY=re_your_resend_key
# Optional From address — must be a Resend-verified sender/domain.
ORDER_EMAIL_FROM="Dose Orders <orders@yourdomain.com>"
