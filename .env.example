NODE_ENV=production
PORT=3001
# SQLite path on the persistent volume (Railway volume mounts at /app/data)
DB_PATH=/app/data/dose.db

# Everything below is OPTIONAL. Shop-specific secrets (Square token, Resend key,
# from-address) are normally entered on the Settings page after logging in and
# stored in the shop's own database. These env vars act as seeds/fallbacks only.

# Seeds the shop password on first boot, skipping the create-password screen.
#DOSE_PASSWORD=choose-a-strong-password

# Fallback used only when no token has been entered in Settings.
#SQUARE_ACCESS_TOKEN=your_square_production_token_here

# Fallbacks for order emailing, used only when not set in Settings.
#RESEND_API_KEY=re_your_resend_key
#ORDER_EMAIL_FROM="Dose Orders <orders@yourdomain.com>"
